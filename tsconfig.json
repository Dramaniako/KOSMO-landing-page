{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["backend/**/*", "tests/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "api/**/*"]
}
