{
  "name": "kosmo-root",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build && npm run build:backend",
    "build:backend": "esbuild backend/api.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --packages=external",
    "type-check": "npm --prefix frontend run type-check && npx tsc --noEmit",
    "type-check:frontend": "npm --prefix frontend run type-check",
    "type-check:backend": "npx tsc --noEmit",
    "dev:backend": "tsx watch backend/server.ts",
    "start": "tsx backend/server.ts",
    "test": "tsx --test tests/auth.test.ts tests/cache.test.ts tests/contract.test.ts tests/jwt.test.ts tests/payment.test.ts tests/rentals.test.ts tests/router.test.ts tests/search.test.ts tests/types.test.ts tests/upload.test.ts tests/validation.test.ts tests/withdrawals.test.ts",
    "test:integration": "tsx --test tests/db_integration.test.ts tests/perf_api.test.ts tests/perf_db.test.ts",
    "test:e2e": "playwright test",
    "db:diagnose": "tsx scripts/diagnose_db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:check-indexes": "tsx scripts/check_db_indexes.ts",
    "db:check-occupancy": "tsx scripts/check_property_occupancy.ts",
    "db:sync-occupancy": "tsx scripts/check_property_occupancy.ts --sync",
    "perf:audit": "tsx scripts/audit_performance.ts",
    "perf:benchmark": "tsx scripts/benchmark_api.ts"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "midtrans-client": "^1.4.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "pdfkit": "^0.19.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.19",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
