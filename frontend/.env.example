# ===================================================
# KOSMO Bali Marketplace - Frontend Environment Variables
# ===================================================

# API Base URL
VITE_API_BASE=/api

# Midtrans Payment Gateway (Client-side Snap SDK)
# Set to 'true' to load production Snap SDK (https://app.midtrans.com/snap/snap.js)
# Set to 'false' to load sandbox Snap SDK (https://app.sandbox.midtrans.com/snap/snap.js)
VITE_MIDTRANS_IS_PRODUCTION=true
VITE_MIDTRANS_CLIENT_KEY=Mid-client-your_production_client_key
