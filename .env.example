# ==============================================
# KOSMO Bali Marketplace - Environment Variables
# ==============================================

# Node Environment
NODE_ENV=production
PORT=5000

# Database Configuration (MySQL / TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=kosmo_db
DB_SSL=true

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Cloudinary Storage (Image & PDF Streaming)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Midtrans Payment Gateway (Production vs Sandbox)
# In production, use Mid-server- / Mid-client- keys with MIDTRANS_IS_PRODUCTION=true
# In sandbox, use SB-Mid-server- / SB-Mid-client- keys with MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=Mid-server-your_production_server_key
MIDTRANS_CLIENT_KEY=Mid-client-your_production_client_key
MIDTRANS_IS_PRODUCTION=true
# Optional custom Snap API URL (defaults to https://app.midtrans.com/snap/v1/transactions in production)
MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/v1/transactions

# Frontend Midtrans Client Configuration (Vite environment variables)
VITE_API_BASE=/api
VITE_MIDTRANS_CLIENT_KEY=Mid-client-your_production_client_key
VITE_MIDTRANS_IS_PRODUCTION=true
