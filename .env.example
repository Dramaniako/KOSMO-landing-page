# ==============================================
# KOSMO Bali Marketplace - Environment Variables
# ==============================================

# Node Environment
NODE_ENV=production
PORT=5000

# Database Configuration (MySQL / TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=kosmo_db
DB_SSL=true

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Cloudinary Storage (Image & PDF Streaming)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=Mid-server-your_server_key
MIDTRANS_CLIENT_KEY=Mid-client-your_client_key
MIDTRANS_IS_PRODUCTION=false

# Client Configuration
VITE_API_BASE=/api
